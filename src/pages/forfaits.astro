---
import { getEmDashEntry, getSeoMeta } from "emdash";
import Base from "../layouts/Base.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "forfaits");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const pageContent = page?.data.content;
const seo = page
	? getSeoMeta(page, {
			siteUrl: Astro.url.origin,
			path: "/forfaits",
			defaultDescription: "Des tarifs clairs et des forfaits tout compris pour apprendre à conduire en toute confiance.",
		})
	: null;
---

<Base
	title={seo?.title || "Forfaits"}
	pageTitle={page?.data.title || "Forfaits"}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	{
		page && pageContent ? (
			<div {...page.edit.content}>
				<MarketingBlocks value={pageContent} />
			</div>
		) : (
			<div class="empty-state">
				<h1>Forfaits</h1>
				<p>Ajoutez les forfaits depuis l’administration.</p>
					{Astro.locals.user && (
						<a href="/_emdash/admin" class="btn btn-primary">
							Adminnistration
						</a>
					)}
			</div>
		)
	}
</Base>

<style>
	.empty-state {
		text-align: center;
		padding: var(--spacing-5xl) var(--spacing-lg);
		max-width: var(--max-width);
		margin: 0 auto;
	}

	.empty-state h1 {
		margin-bottom: var(--spacing-md);
	}

	.empty-state p {
		color: var(--color-muted);
		margin-bottom: var(--spacing-xl);
	}
</style>
